# Copy this file to .env and replace values before running docker compose.

# Database
POSTGRES_DB=imageprocessor
POSTGRES_USER=imageprocessor
POSTGRES_PASSWORD=replace-with-strong-password

# RabbitMQ
RABBITMQ_USER=imageprocessor
RABBITMQ_PASSWORD=replace-with-strong-password
RABBITMQ_QUEUE_NAME=image-processing

# MinIO / S3
MINIO_ROOT_USER=imageprocessor
MINIO_ROOT_PASSWORD=replace-with-strong-password
S3_BUCKET_NAME=image-uploads

# App settings
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
CORS_ALLOWED_ORIGIN_0=http://localhost:8080

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Host port mappings
WEB_PORT=8080
API_PORT=5000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
