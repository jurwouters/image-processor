@page "/process-images"

<script type="module" src="@Assets["Components/Pages/ProcessImages.razor.js"]"></script>

<PageTitle>Image Processing</PageTitle>

<h1>Image Processing</h1>
<p class="text-muted">Select your images, configure operations per image, start processing, then download the results.</p>

<div class="row g-4 mt-1">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">1) Set up your images</h2>

                <div class="mb-3">
                    <label class="form-label">Images</label>
                    <InputFile id="image-files-input" OnChange="HandleFilesSelected" multiple class="form-control" />
                    <div class="form-text">Select one or more images to process.</div>
                </div>

                @if (_selectedFiles.Count > 0)
                {
                    <div class="card border-secondary mb-3">
                        <div class="card-body">
                            <h3 class="h6">Default settings for all images</h3>

                            <div class="form-text mb-3">Enable any default operation below to apply default settings to all images and disable per-image settings.</div>

                            <div class="form-check mb-2">
                                <input id="defaultResizeEnabled" class="form-check-input" type="checkbox" @bind="_defaultSettings.ResizeEnabled" />
                                <label class="form-check-label" for="defaultResizeEnabled">Resize</label>
                            </div>

                            @if (_defaultSettings.ResizeEnabled)
                            {
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label">Width (%)</label>
                                        <input type="number" class="form-control" min="1" step="0.1" @bind="_defaultSettings.ResizeWidthPercentage" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">Height (%)</label>
                                        <input type="number" class="form-control" min="1" step="0.1" @bind="_defaultSettings.ResizeHeightPercentage" />
                                    </div>
                                </div>
                            }

                            <div class="form-check mb-2">
                                <input id="defaultCropEnabled" class="form-check-input" type="checkbox" @bind="_defaultSettings.CropEnabled" />
                                <label class="form-check-label" for="defaultCropEnabled">Crop</label>
                            </div>

                            @if (_defaultSettings.CropEnabled)
                            {
                                <div class="row g-2 mb-3">
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">X</label>
                                        <input type="number" class="form-control" min="0" @bind="_defaultSettings.CropX" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Y</label>
                                        <input type="number" class="form-control" min="0" @bind="_defaultSettings.CropY" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Width (%)</label>
                                        <input type="number" class="form-control" min="1" step="0.1" @bind="_defaultSettings.CropWidthPercentage" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Height (%)</label>
                                        <input type="number" class="form-control" min="1" step="0.1" @bind="_defaultSettings.CropHeightPercentage" />
                                    </div>
                                </div>
                            }

                            <div class="form-check mb-2">
                                <input id="defaultRotateEnabled" class="form-check-input" type="checkbox" @bind="_defaultSettings.RotateEnabled" />
                                <label class="form-check-label" for="defaultRotateEnabled">Rotate</label>
                            </div>

                            @if (_defaultSettings.RotateEnabled)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Degrees</label>
                                        <input type="number" class="form-control" step="0.1" @bind="_defaultSettings.RotateDegrees" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <h3 class="h6">Operation settings per image</h3>

                    @for (var i = 0; i < _selectedFiles.Count; i++)
                    {
                        var file = _selectedFiles[i];
                        var settings = _selectedImageSettings[i];

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <strong>@file.Name</strong>
                                        @if (settings.SourceWidth.HasValue && settings.SourceHeight.HasValue)
                                        {
                                            <div class="small text-muted">@settings.SourceWidth x @settings.SourceHeight px</div>
                                        }
                                    </div>
                                    <small class="text-muted">@FormatSize(file.Size)</small>
                                </div>

                                <fieldset disabled="@IsDefaultSettingsEnabled">
                                    <div class="form-check mb-2">
                                        <input id="resizeEnabled-@i" class="form-check-input" type="checkbox" @bind="settings.ResizeEnabled" />
                                        <label class="form-check-label" for="resizeEnabled-@i">Resize</label>
                                    </div>

                                    @if (settings.ResizeEnabled)
                                    {
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label">Width</label>
                                                <input type="number" class="form-control" min="1" @bind="settings.ResizeWidth" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label">Height</label>
                                                <input type="number" class="form-control" min="1" @bind="settings.ResizeHeight" />
                                            </div>
                                        </div>
                                    }

                                    <div class="form-check mb-2">
                                        <input id="cropEnabled-@i" class="form-check-input" type="checkbox" @bind="settings.CropEnabled" />
                                        <label class="form-check-label" for="cropEnabled-@i">Crop</label>
                                    </div>

                                    @if (settings.CropEnabled)
                                    {
                                        <div class="row g-2 mb-3">
                                            <div class="col-6 col-md-3">
                                                <label class="form-label">X</label>
                                                <input type="number" class="form-control" min="0" @bind="settings.CropX" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label">Y</label>
                                                <input type="number" class="form-control" min="0" @bind="settings.CropY" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label">Width</label>
                                                <input type="number" class="form-control" min="1" @bind="settings.CropWidth" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label">Height</label>
                                                <input type="number" class="form-control" min="1" @bind="settings.CropHeight" />
                                            </div>
                                        </div>
                                    }

                                    <div class="form-check mb-2">
                                        <input id="rotateEnabled-@i" class="form-check-input" type="checkbox" @bind="settings.RotateEnabled" />
                                        <label class="form-check-label" for="rotateEnabled-@i">Rotate</label>
                                    </div>

                                    @if (settings.RotateEnabled)
                                    {
                                        <div class="row g-2 mb-2">
                                            <div class="col-12 col-md-4">
                                                <label class="form-label">Degrees</label>
                                                <input type="number" class="form-control" step="0.1" @bind="settings.RotateDegrees" />
                                            </div>
                                        </div>
                                        <div class="form-text">Rotation is automatically cropped to remove empty corner triangles.</div>
                                    }
                                </fieldset>
                            </div>
                        </div>
                    }
                }

                <button class="btn btn-primary" @onclick="ProcessBatchAsync" disabled="@_isProcessing">Start processing</button>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">2) Progress</h2>

                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <div class="alert alert-info">@_statusMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (_createdBatch is not null)
                {
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Job reference</dt>
                        <dd class="col-sm-8"><code>@_createdBatch.Id</code></dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@MapBatchStatus(_batchStatus)</dd>
                    </dl>
                }

                @if (_downloadItems.Count > 0)
                {
                    <h3 class="h6">3) Download</h3>
                    <p class="text-muted small">Your files are ready to open or download here.</p>

                    <ul class="list-group">
                        @foreach (var item in _downloadItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@item.FileName</span>
                                <a class="btn btn-outline-secondary btn-sm" href="/download/@item.BatchId/@item.ImageId" download="@item.FileName">Download</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
